{
  "name": "spotify-local",
  "displayName": "Spotify Local",
  "description": "Controla Spotify, busca canciones y muestra la letra sincronizada y traducida desde VS Code. Uso personal.",
  "version": "0.4.0",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/RodriC98374/spotify-extension-pj.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spotifyLocal.login",
        "title": "Iniciar sesión",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.logout",
        "title": "Cerrar sesión",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.playPause",
        "title": "Reproducir / Pausar",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.next",
        "title": "Siguiente canción",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.previous",
        "title": "Canción anterior",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.toggleShuffle",
        "title": "Activar o desactivar el modo aleatorio",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.setVolume",
        "title": "Ajustar volumen",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.volumeUp",
        "title": "Subir volumen",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.volumeDown",
        "title": "Bajar volumen",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.transferPlayback",
        "title": "Transferir reproducción a un dispositivo",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.search",
        "title": "Buscar canción",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.showLyrics",
        "title": "Mostrar letra",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.toggleStatusBarLyrics",
        "title": "Activar o desactivar la letra en la barra de estado",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.lyricsOffsetIncrease",
        "title": "Subir offset de la letra (+250 ms)",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.lyricsOffsetDecrease",
        "title": "Bajar offset de la letra (−250 ms)",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.toggleTranslation",
        "title": "Activar o desactivar la traducción de la letra",
        "category": "Spotify",
        "icon": "$(globe)"
      },
      {
        "command": "spotifyLocal.pickFromLibrary",
        "title": "Elegir de mi biblioteca",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.showLibrary",
        "title": "Mostrar biblioteca",
        "category": "Spotify"
      },
      {
        "command": "spotifyLocal.refreshLibrary",
        "title": "Actualizar biblioteca",
        "category": "Spotify",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spotifyLocal.toggleTranslation",
          "when": "view == spotifyLocal.lyrics",
          "group": "navigation"
        },
        {
          "command": "spotifyLocal.refreshLibrary",
          "when": "view == spotifyLocal.library",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "spotifyLocal.library",
        "contents": "Inicia sesión para ver tus playlists y tus me gusta.\n[Iniciar sesión](command:spotifyLocal.login)",
        "when": "spotifyLocal.library == loggedOut"
      },
      {
        "view": "spotifyLocal.library",
        "contents": "Para ver tu biblioteca hay que volver a iniciar sesión y aceptar el permiso nuevo de Spotify.\n[Volver a iniciar sesión](command:spotifyLocal.login)",
        "when": "spotifyLocal.library == needsPermission"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spotifyLocal",
          "title": "Spotify Local",
          "icon": "media/lyrics.svg"
        }
      ]
    },
    "views": {
      "spotifyLocal": [
        {
          "type": "webview",
          "id": "spotifyLocal.lyrics",
          "name": "Letra"
        },
        {
          "id": "spotifyLocal.library",
          "name": "Biblioteca",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Spotify Local",
      "properties": {
        "spotifyLocal.clientId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Client ID de tu app en el [Spotify Developer Dashboard](https://developer.spotify.com/dashboard). La app debe tener registrado el Redirect URI `http://127.0.0.1:8888/callback`. No se usa Client Secret."
        },
        "spotifyLocal.lyricsOffsetMs": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Desfase de la letra en milisegundos. Un valor positivo adelanta la letra; uno negativo la retrasa, que es lo que compensa la latencia de unos audífonos Bluetooth."
        },
        "spotifyLocal.showLyricsInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Muestra la línea actual de la letra en la barra de estado."
        },
        "spotifyLocal.translateLyrics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Muestra debajo de cada línea de la letra su traducción al español. La traducción es automática y gratuita: las líneas de la letra se envían a [MyMemory](https://mymemory.translated.net), que admite unas pocas canciones nuevas al día."
        },
        "spotifyLocal.translationEmail": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Opcional. Correo con el que identificarte ante [MyMemory](https://mymemory.translated.net/doc/usagelimits.php): sube el cupo de traducción de 5.000 a 50.000 caracteres al día. Se envía a MyMemory con cada consulta de traducción, y a nadie más."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "vsix": "npx --yes @vscode/vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/vscode": "1.140.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
